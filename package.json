{
  "name": "@pavelsiba/quality-js",
  "version": "1.0.2",
  "description": "Общие конфиги quality gates для TS/JS-проектов: Biome, tsconfig, commitlint.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pavelsiba/quality-js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "biome-manifest.json",
    "configs",
    "tsconfig",
    "commitlint"
  ],
  "exports": {
    ".": {
      "biome": "./biome-manifest.json"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./commitlint": {
      "types": "./commitlint/index.d.ts",
      "default": "./commitlint/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@biomejs/biome": ">=2.6.0",
    "@commitlint/config-conventional": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "@commitlint/config-conventional": {
      "optional": true
    }
  },
  "scripts": {
    "lint": "biome check",
    "lint:md": "npx --yes markdownlint-cli2@0.24.0",
    "test": "node --test \"test/*.test.js\"",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "lefthook": "^2.2.2",
    "semantic-release": "^25.0.9"
  }
}
