// Базовый конфиг Biome для TS/JS-проектов pavelsiba. Стиль — общий для всех эталонов
// (yd-mcp, more-shop, autopartsAI); правила сверх recommended — встроенные аналоги sonarjs
// (таблица соответствия — sonarjs-biome.md в скилле quality-gates набора pavelsiba-skills).
// warn — правила из nursery и пороговые: поведение или порог ещё уточняются.
{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80
          }
        },
        "noExcessiveNestedCallbacks": "warn",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessContinue": "error",
        "noUselessReturn": "error",
        "noUselessTernary": "error",
        "noUselessUndefinedInitialization": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noInnerDeclarations": "error",
        "noSelfAssign": "error",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedInstantiation": "error",
        "noUnusedVariables": "error",
        "useValidForDirection": "error",
        "useYield": "error"
      },
      "nursery": {
        "noFloatingPromises": "warn",
        "noImpliedEval": "warn",
        "noNestedSwitch": "warn",
        "noNestedTemplateLiterals": "warn",
        "noThisOutsideOfClass": "warn",
        "useRegexpExec": "warn",
        "useSimplifiedBooleanReturn": "warn"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "useArrayLiterals": "error",
        "useCollapsedIf": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useNodejsImportProtocol": "error",
        "useTestHooksOnTop": "error",
        "useUnicodeRegex": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noConfusingLabels": "error",
        "noControlCharactersInRegex": "error",
        "noDuplicateCase": "error",
        "noDuplicateElseIf": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noFallthroughSwitchClause": "error",
        "noFocusedTests": "error",
        "noForIn": "error",
        "noGlobalAssign": "error",
        "noIdenticalTestTitle": "error",
        "noLoopFunc": "error",
        "noMisleadingCharacterClass": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "error",
        "noSkippedTests": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useDefaultSwitchClauseLast": "error",
        "useGuardForIn": "error",
        "useIterableCallbackReturn": "error"
      }
    }
  },
  // Плагины GritQL (plugins/*.grit): безопасность Node и тесты. Путь считается от этого файла (resolutionKind: config),
  // уровень info — как у любого нового правила в минорной версии. Гасить: biome-ignore lint/plugin/<имя>: причина.
  "plugins": [
    { "path": "./plugins/unverified-certificate.grit", "resolutionKind": "config" },
    { "path": "./plugins/hashing.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-weak-cipher.grit", "resolutionKind": "config" },
    { "path": "./plugins/weak-ssl.grit", "resolutionKind": "config" },
    { "path": "./plugins/insecure-jwt-token.grit", "resolutionKind": "config" },
    { "path": "./plugins/cookie-no-httponly.grit", "resolutionKind": "config" },
    { "path": "./plugins/insecure-cookie.grit", "resolutionKind": "config" },
    { "path": "./plugins/cors.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-same-argument-assert.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-trivial-assertions.grit", "resolutionKind": "config" },
    { "path": "./plugins/vitest-mock-at-module-scope.grit", "resolutionKind": "config" },
    { "path": "./plugins/async-test-assertions.grit", "resolutionKind": "config" },
    { "path": "./plugins/encryption-secure-mode.grit", "resolutionKind": "config" },
    { "path": "./plugins/file-permissions.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-weak-keys.grit", "resolutionKind": "config" },
    { "path": "./plugins/unverified-hostname.grit", "resolutionKind": "config" },
    { "path": "./plugins/xml-parser-xxe.grit", "resolutionKind": "config" },
    { "path": "./plugins/production-debug.grit", "resolutionKind": "config" },
    { "path": "./plugins/publicly-writable-directories.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-os-command-from-path.grit", "resolutionKind": "config" },
    { "path": "./plugins/assertions-in-test-cases.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-incomplete-assertions.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-empty-parameterized-test-dataset.grit", "resolutionKind": "config" },
    { "path": "./plugins/synchronous-suite-callback.grit", "resolutionKind": "config" },
    { "path": "./plugins/test-check-exception.grit", "resolutionKind": "config" },
    { "path": "./plugins/prefer-specific-assertions.grit", "resolutionKind": "config" },
    { "path": "./plugins/no-interpolation-in-inline-snapshots.grit", "resolutionKind": "config" }
  ],
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.*", "**/*.spec.*"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
