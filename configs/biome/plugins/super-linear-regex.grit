// Регулярка с полиномиальным возвратом (ReDoS): два соседних неограниченных квантора по пересекающимся
// классам (\s*\s*, \d+\w+, .*.*) или два .* без якоря ^ в начале (/.*a.*b/). Эвристика по тексту литерала.
// Гасить: // biome-ignore lint/plugin/super-linear-regex: причина
JsRegexLiteralExpression() as $re where {
  or {
    $re <: r"^/(?:.*[^\\])?[\\][s][*+][?]?[\\][s][*+].*/[a-z]*$",
    $re <: r"^/(?:.*[^\\])?[\\][d][*+][?]?[\\][dw][*+].*/[a-z]*$",
    $re <: r"^/(?:.*[^\\])?[\\][w][*+][?]?[\\][dw][*+].*/[a-z]*$",
    $re <: r"^/(?:.*[^\\])?[.][*+][?]?[.][*+].*/[a-z]*$",
    and { $re <: r"^/(?:.*[^\\])?[.][*+].*[^\\][.][*+].*/[a-z]*$", $re <: not r"^/[\^].*" }
  },
  // в проверках тестов регулярка идёт по короткому тексту ошибки: expect(x).toThrow(/a.*b/)
  $re <: not within `$_.$matcher($...)` where {
    $matcher <: r"^(?:toMatch|toThrow|toThrowError|toContain|toHaveProperty)$"
  },
  register_diagnostic(span=$re, message="super-linear-regex: пересекающиеся неограниченные кванторы — время растёт как квадрат длины входа. Сузьте класс символов, ограничьте повторы или добавьте якорь ^.", severity="info")
}
