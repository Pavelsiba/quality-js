// Регулярка с экспоненциальным возвратом (ReDoS): группа, начинающаяся и кончающаяся неограниченным квантором,
// сама под неограниченным квантором, например (a+)+ или ([a-z]+\s*)*. Эвристика по тексту литерала, не
// анализ автомата. Разделитель в начале группы ((?:-[a-z]+)*) делает перебор однозначным и не ловится.
// Гасить: // biome-ignore lint/plugin/slow-regex: причина
// Обозначения: атом — символ, экранированный символ или класс [...]; тело — любая цепочка без скобок.
JsRegexLiteralExpression() as $re where {
  or {
    // (a+)+, (?:\w+)*, ([a-z]+\s*)*: первый атом под квантором, последний квантор перед закрывающей скобкой
    $re <: r"^/(?:.*[^\\])?[(](?:[?]:)?(?:[^()\[\]\\|+*?{}]|[\\].|[\[][^\]]*[\]])[+*][?]?(?:(?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[+*][?]?)?[)](?:[+*]|[{][0-9]+,[}]).*/[a-z]*$",
    // квантор после |: (a|b+)*
    $re <: r"^/(?:.*[^\\])?[(](?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[|](?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[+*](?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[)](?:[+*]|[{][0-9]+,[}]).*/[a-z]*$",
    // квантор до |: (a+|b)*
    $re <: r"^/(?:.*[^\\])?[(](?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[+*](?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[|](?:[^()\[\]\\]|[\\].|[\[][^\]]*[\]])*[)](?:[+*]|[{][0-9]+,[}]).*/[a-z]*$"
  },
  register_diagnostic(span=$re, message="slow-regex: вложенный неограниченный квантор, например (a+)+ — на неудачном входе перебор растёт экспоненциально. Уберите вложенность или ограничьте повторы ({1,20}).", severity="info")
}
